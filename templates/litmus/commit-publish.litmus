C commit-publish
(* generated-from: templates/litmus/commit-publish.litmus sha256:15d1491bb05768658df3fc4dc55bbc20232a2c332e228bc4a23b17140717c6e6 *)

(*
 * Publication order for a transaction commit: write the new block's contents first,
 * then write the superblock that points at it.
 * Bad outcome = a reader sees the new generation but reads the old block contents
 *               (the superblock points at a block whose contents are not yet visible
 *                → garbage on mount).
 *
 * This is the most basic ordering in a COW filesystem: the whole of "a commit is
 * atomic" rests on it.
 *
 * P0 = the writer (committing a transaction); P1 = the reader (mount or concurrent read).
 *
 * singlefs-expect: Never
 * singlefs-models: none — template: shows how a Never is paired with its control; it models no code.
 *   Once the project has code implementing this order, replace this line with <repo path>::<function name>
 *   and write a test that reads this file.
 *)

{}

P0(int *blk, int *gen)
{
	WRITE_ONCE(*blk, 1);
	smp_wmb();
	WRITE_ONCE(*gen, 1);
}

P1(int *blk, int *gen)
{
	int r0;
	int r1;

	r0 = READ_ONCE(*gen);
	smp_rmb();
	r1 = READ_ONCE(*blk);
}

exists (1:r0=1 /\ 1:r1=0)
